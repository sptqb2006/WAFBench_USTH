# ==========================================
# WAFBench Environment Configuration
# ==========================================

# Gateway Ports & Mode
GATEWAY_PORT=8080
DIRECT_APP_PORT=8001
DASHBOARD_PORT=8501

# WAF Operating Mode: DetectionOnly or On (Blocking)
WAF_RULE_ENGINE=DetectionOnly

# OWASP CRS Settings
CRS_PARANOIA_LEVEL=1
CRS_INBOUND_ANOMALY_THRESHOLD=5
CRS_OUTBOUND_ANOMALY_THRESHOLD=4

# Target Application Database (app-db)
APP_DB_HOST=app-db
APP_DB_PORT=5432
APP_DB_NAME=vulnerable_db
APP_DB_USER=app_user
APP_DB_PASSWORD=app_secret_pass

# Telemetry Event Database (event-db)
EVENT_DB_HOST=event-db
EVENT_DB_PORT=5432
EVENT_DB_NAME=wafbench_events
EVENT_DB_USER=telemetry_user
EVENT_DB_PASSWORD=telemetry_secret_pass
